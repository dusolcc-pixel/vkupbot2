{
    "gdflix": {
        "main_domain": "new6.gdflix.io",
        "fetch_method": "curl_cffi",
        "fallback_methods": [
            "browser",
            "requests"
        ],
        "fallback_status_codes": [
            401,
            403,
            408,
            425,
            429,
            500,
            502,
            503,
            504
        ],
        "steps": [
            {
                "targets": [
                    "instant.busycdn.xyz"
                ]
            }
        ],
        "final": {
            "type": "query_parameter",
            "parameter": "url"
        },
        "aliases": [
            "gdlink.dev"
        ],
        "fallback_if_missing_target": true
    },
    "hubcloud": {
        "main_domain": "hubcloud.ist",
        "fetch_method": "requests",
        "steps": [
            {
                "targets": [
                    "gamerxyt.com",
                    "sportverse.cc"
                ]
            },
            {
                "targets": [
                    "pixel.hubcloud.ist",
                    "gpdl.hubcloud.ist",
                    "gpdl2.hubcloud.ist"
                ]
            }
        ],
        "final": {
            "type": "query_parameter",
            "parameter": "link"
        }
    },
    "driveseed": {
        "main_domain": "driveseed.org",
        "fetch_method": "requests",
        "steps": [
            {
                "targets": [
                    "cdn.video-gen.xyz"
                ]
            }
        ],
        "final": {
            "type": "query_parameter",
            "parameter": "url"
        }
    },
    "titancloud": {
        "main_domain": "titancloud.site",
        "fetch_method": "browser",
        "steps": [],
        "direct_targets": [
            "workers.dev"
        ],
        "final": {
            "type": "current_url"
        }
    },
    "mnmcloud 2": {
        "main_domain": "mnmcloud.fun",
        "fetch_method": "browser",
        "steps": [],
        "direct_targets": [
            "video-downloads.googleusercontent.com"
        ],
        "final": {
            "type": "current_url"
        }
    }
}
